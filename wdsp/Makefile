#
# Makefile for WDSP library
# This one creates libwdsp.a intended for statis linking
#

CFLAGS?= -pthread -O3 -D_GNU_SOURCE -Wno-parentheses -Wcast-align
CFLAGS += -I../libspecbleach/include

FFTWINCLUDE=`pkg-config --cflags fftw3`

COMPILE=$(CC) $(CFLAGS) $(FFTWINCLUDE)

OBJS= amd.o \
ammod.o \
amsq.o \
analyzer.o \
anf.o \
anr.o \
apfshadow.o \
bandpass.o \
calcc.o \
calculus.o \
cblock.o \
cfcomp.o \
cfir.o \
channel.o \
cmath.o \
compress.o \
delay.o \
dexp.o \
div.o \
doublepole.o \
eer.o \
emnr.o \
emph.o \
eq.o \
extrapolate.o \
fcurve.o \
fir.o \
firmin.o \
fmd.o \
fmmod.o \
fmsq.o \
gain.o \
gaussian.o \
gen.o \
icfir.o \
iir.o \
impulse_cache.o \
iobuffs.o \
iqc.o \
lmath.o \
main.o \
matchedCW.o \
meter.o \
meterlog10.o \
nbp.o \
nnet.o \
nnio.o \
nnr.o \
nnrbypass.o \
nnr_model_0.o \
nnr_model_1.o \
nnr_model_2.o \
nnr_model_3.o \
nob.o \
nobII.o \
nurbs.o \
nurbs_fit.o \
nurbs_spline.o \
osctrl.o \
patchpanel.o \
phrot.o \
resample.o \
reshb.o \
rmatch.o \
RXA.o \
sbnr.o \
sender.o \
shift.o \
siphon.o \
slew.o \
snb.o \
ssql.o \
syncbuffs.o \
TXA.o \
utilities.o \
version.o \
varsamp.o \
wbfm.o \
wcpAGC.o \
wdsp_platform_posix.o \
wisdom.o \
zetaHat.o

libwdsp.a:	$(OBJS)
	ar rv libwdsp.a $(OBJS)
	ranlib libwdsp.a

.c.o:
	$(COMPILE) -c -o $@ $<


clean:
	-rm -f libwdsp.a $(OBJS)

#############################################################################
#
# Create a file named DEPEND containing dependencies, to be added to
# the Makefile. This is done here because we need lots of #defines
# to make it right.
# Since src/MacTTS.m is Objective-C, create the final line manually
#
#############################################################################

.PHONY: DEPEND
DEPEND:
	rm -f DEPEND
	touch DEPEND
	export LC_ALL=C && makedepend -D__APPLE__ -D__linux__ -f DEPEND -I. \
		-I../libspecbleach/include *.c *.h

#############################################################################
#
# What follows is automatically generated by the "makedepend" program
#
#############################################################################

